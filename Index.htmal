<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MCQ Test Portal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --ink: #16202B;
      --paper: #EFEBE0;
      --paper-2: #E2DBC6;
      --white: #FBF9F3;
      --steel: #38566B;
      --steel-soft: #7C93A3;
      --amber: #D98E2B;
      --amber-deep: #A9691F;
      --signal: #4C8C6B;

      --font-display: 'Space Grotesk', sans-serif;
      --font-body: 'IBM Plex Sans', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      --radius: 5px;
    }

    [data-theme="light"] {
      --bg: var(--paper);
      --surface: var(--white);
      --surface-2: var(--paper-2);
      --text: var(--ink);
      --text-dim: #5C6B78;
      --border: #CFC6AE;
      --accent: var(--amber-deep);
      --accent-contrast: var(--white);
      --dot: rgba(56, 86, 107, 0.07);
    }

    [data-theme="dark"] {
      --bg: var(--ink);
      --surface: #1F2C39;
      --surface-2: #263748;
      --text: var(--paper);
      --text-dim: #8FA0AF;
      --border: #37495C;
      --accent: var(--amber);
      --accent-contrast: var(--ink);
      --dot: rgba(143, 160, 175, 0.09);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background-color: var(--bg);
      background-image: radial-gradient(
        var(--dot) 1.2px,
        transparent 1.2px
      );
      background-size: 22px 22px;
      color: var(--text);
      font-family: var(--font-body);
      line-height: 1.5;
      transition: background-color .25s ease, color .25s ease;
      -webkit-font-smoothing: antialiased;
    }

    button {
      font-family: inherit;
      cursor: pointer;
    }

    .mono {
      font-family: var(--font-mono);
    }

    /* HEADER */

    .site-header {
      max-width: 1100px;
      margin: auto;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-seal {
      width: 40px;
      height: 40px;
      border: 2px solid var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 600;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.25;
    }

    .brand-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 16px;
      letter-spacing: .04em;
    }

    .brand-sub {
      font-size: 11px;
      color: var(--text-dim);
    }

    .theme-toggle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .theme-toggle:hover {
      border-color: var(--accent);
    }

    .theme-toggle svg {
      width: 17px;
      height: 17px;
    }

    /* MAIN */

    .container {
      max-width: 1000px;
      margin: auto;
      padding: 55px 24px 80px;
    }

    .hero {
      text-align: center;
      margin-bottom: 42px;
    }

    .eyebrow {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    h1 {
      font-family: var(--font-display);
      font-size: clamp(30px, 5vw, 46px);
      margin: 0 0 14px;
      line-height: 1.1;
    }

    .hero p {
      max-width: 600px;
      margin: auto;
      color: var(--text-dim);
      font-size: 16px;
    }

    /* SELECTION */

    .selection-card {
      max-width: 760px;
      margin: auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 30px;
      box-shadow: 0 12px 30px rgba(0,0,0,.10);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: 20px;
      margin: 0 0 18px;
    }

    .subject-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 34px;
    }

    .subject-btn,
    .class-btn {
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      padding: 16px;
      border-radius: var(--radius);
      text-align: left;
      font-family: var(--font-display);
      font-weight: 600;
      transition:
        border-color .15s ease,
        background .15s ease,
        transform .15s ease;
    }

    .subject-btn:hover,
    .class-btn:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
    }

    .subject-btn.selected,
    .class-btn.selected {
      background: var(--accent);
      color: var(--accent-contrast);
      border-color: var(--accent);
    }

    .subject-btn small,
    .class-btn small {
      display: block;
      margin-top: 4px;
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 400;
      opacity: .75;
    }

    .class-section {
      border-top: 1px dashed var(--border);
      padding-top: 28px;
    }

    .class-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .start-area {
      margin-top: 30px;
      border-top: 1px dashed var(--border);
      padding-top: 24px;
      text-align: center;
    }

    .selection-info {
      color: var(--text-dim);
      font-size: 13px;
      margin-bottom: 15px;
    }

    .start-btn {
      width: 100%;
      max-width: 300px;
      padding: 13px 20px;
      border: none;
      border-radius: var(--radius);
      background: var(--accent);
      color: var(--accent-contrast);
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 700;
      transition: transform .15s ease, filter .15s ease;
    }

    .start-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      filter: brightness(1.06);
    }

    .start-btn:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    /* FOOTER */

    footer {
      border-top: 1px solid var(--border);
      padding: 25px 24px;
      color: var(--text-dim);
      font-size: 12px;
      text-align: center;
    }

    /* MOBILE */

    @media (max-width: 600px) {
      .container {
        padding-top: 38px;
      }

      .selection-card {
        padding: 22px 18px;
      }

      .subject-grid {
        grid-template-columns: 1fr;
      }

      .class-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .site-header {
        padding: 18px;
      }
    }
  </style>
</head>

<body>

  <header class="site-header">

    <div class="brand">
      <div class="brand-seal">MCQ</div>

      <div class="brand-text">
        <span class="brand-name">MCQ TEST PORTAL</span>
        <span class="brand-sub">Random Practice Tests</span>
      </div>
    </div>

    <button
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle dark mode"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
      </svg>
    </button>

  </header>


  <main class="container">

    <section class="hero">

      <div class="eyebrow">
        MCQ PRACTICE SYSTEM
      </div>

      <h1>
        Which Subject MCQ You Want?
      </h1>

      <p>
        Choose a subject and class. Your test will generate
        random questions from the selected question bank.
      </p>

    </section>


    <section class="selection-card">

      <h2 class="section-title">
        1. Select Subject
      </h2>

      <div class="subject-grid">

        <button
          class="subject-btn"
          data-subject="science"
        >
          GENERAL SCIENCE
          <small>Science MCQs</small>
        </button>

        <button
          class="subject-btn"
          data-subject="math"
        >
          MATHEMATICS
          <small>Mathematics MCQs</small>
        </button>

        <button
          class="subject-btn"
          data-subject="social"
        >
          SOCIAL SCIENCE
          <small>History, Geography, Civics</small>
        </button>

        <button
          class="subject-btn"
          data-subject="english"
        >
          ENGLISH
          <small>English MCQs</small>
        </button>

        <button
          class="subject-btn"
          data-subject="all"
        >
          ALL SUBJECTS
          <small>Mixed subject MCQs</small>
        </button>

      </div>


      <div class="class-section">

        <h2 class="section-title">
          2. Choose Class
        </h2>

        <div class="class-grid">

          <button
            class="class-btn"
            data-class="9"
          >
            CLASS 9TH
            <small>Class IX</small>
          </button>

          <button
            class="class-btn"
            data-class="10"
          >
            CLASS 10TH
            <small>Class X</small>
          </button>

          <button
            class="class-btn"
            data-class="11"
          >
            CLASS 11TH
            <small>Class XI</small>
          </button>

          <button
            class="class-btn"
            data-class="12"
          >
            CLASS 12TH
            <small>Class XII</small>
          </button>

        </div>

      </div>


      <div class="start-area">

        <div class="selection-info" id="selectionInfo">
          Select a subject and class to continue.
        </div>

        <button
          class="start-btn"
          id="startBtn"
          disabled
        >
          START RANDOM TEST →
        </button>

      </div>

    </section>

  </main>


  <footer>
    MCQ Test Portal — Randomized Practice System
  </footer>


  <script>

    let selectedSubject = null;
    let selectedClass = null;

    const subjectButtons =
      document.querySelectorAll(".subject-btn");

    const classButtons =
      document.querySelectorAll(".class-btn");

    const startBtn =
      document.getElementById("startBtn");

    const selectionInfo =
      document.getElementById("selectionInfo");


    /* SUBJECT SELECTION */

    subjectButtons.forEach(button => {

      button.addEventListener("click", () => {

        subjectButtons.forEach(btn =>
          btn.classList.remove("selected")
        );

        button.classList.add("selected");

        selectedSubject =
          button.dataset.subject;

        updateSelection();

      });

    });


    /* CLASS SELECTION */

    classButtons.forEach(button => {

      button.addEventListener("click", () => {

        classButtons.forEach(btn =>
          btn.classList.remove("selected")
        );

        button.classList.add("selected");

        selectedClass =
          button.dataset.class;

        updateSelection();

      });

    });


    /* UPDATE SELECTION */

    function updateSelection() {

      if (selectedSubject && selectedClass) {

        const subjectName =
          document.querySelector(
            `.subject-btn[data-subject="${selectedSubject}"]`
          ).childNodes[0].textContent.trim();

        selectionInfo.textContent =
          `${subjectName} • CLASS ${selectedClass}TH`;

        startBtn.disabled = false;

      } else if (selectedSubject) {

        selectionInfo.textContent =
          "Now choose your class.";

        startBtn.disabled = true;

      } else if (selectedClass) {

        selectionInfo.textContent =
          "Now choose your subject.";

        startBtn.disabled = true;

      } else {

        selectionInfo.textContent =
          "Select a subject and class to continue.";

        startBtn.disabled = true;

      }

    }


    /* START TEST */

    startBtn.addEventListener("click", () => {

      if (!selectedSubject || !selectedClass) {
        return;
      }

      const url =
        `test.html?subject=${encodeURIComponent(selectedSubject)}&class=${encodeURIComponent(selectedClass)}`;

      window.location.href = url;

    });


    /* DARK / LIGHT MODE */

    document
      .getElementById("themeToggle")
      .addEventListener("click", () => {

        const html =
          document.documentElement;

        const current =
          html.getAttribute("data-theme");

        html.setAttribute(
          "data-theme",
          current === "dark"
            ? "light"
            : "dark"
        );

      });

  </script>

</body>
</html>
